# ─── Secrets / local config ─────────────────────────────────────────────
.env
.env.*
*.local.toml
*.local.yaml
*.local.json
# CueBooth runtime config that contains site-specific identifiers.
# This is the file the server loads by default (cmd/cuebooth-server/main.go)
# and the one docs/sample-deployment.md tells operators to create from the
# §6 sample — it holds the OBS password and LAN IPs, so it must stay local.
# Only *.example.toml is tracked. (*.local.toml above already covers any
# cuebooth.local.toml variant.)
server/configs/cuebooth.toml

# ─── Site-specific / personal material ──────────────────────────────────
# private/ holds the original planning notes, the reference deployment's
# runbook + Companion + OBS configs, and the earlier C# prototype. None
# of it belongs in the public repo. Anonymized samples derived from it
# may later be checked into docs/.
private/

# ─── Embedded web client (server/internal/webui) ────────────────────────
# `make web` stages the Flutter web build here for go:embed. It is a build
# artifact of client/, not source. .gitkeep stays so a fresh clone still
# satisfies the embed directive.
server/internal/webui/dist/*
!server/internal/webui/dist/.gitkeep
